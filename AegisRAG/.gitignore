# Python Bytecode & Builds
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Virtual Environment
.venv/
venv/
env/

# Type Checking & Linters
.mypy_cache/
.ruff_cache/

# Testing & Coverage
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage/
htmlcov/
coverage.xml
.benchmarks/

# Logging
*.log
logs/
!storage/logs/
storage/logs/*
!storage/logs/.gitkeep

# Secrets & Environment Variables (Keep .env.example)
.env
.env.*
!.env.example
*.pem
*.key

# IDEs & System Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# RAG Storage & Model Cache (保留目录骨架，忽略数据)
storage/qdrant_data/*
!storage/qdrant_data/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
.cache/
.fastembed/
.trafilatura/

# SQLite & Databases
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
storage/*.db
storage/*.db-wal
storage/*.db-shm

# SQLite Memory URI physical file leak prevention
:memory:
