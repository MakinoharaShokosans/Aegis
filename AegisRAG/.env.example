# ==============================================================================
# AegisRAG 环境变量模板 (.env)
# ==============================================================================

# Qdrant 远程鉴权密钥 (当 mode="server" 且启用鉴权时使用)
QDRANT_API_KEY=

# 远端 Embedding 服务密钥 ([embedding].mode="remote" 时使用，默认网关 api.openlux.ai/v1)
EMBEDDING_API_KEY=

# 远端 Rerank 服务密钥 ([rerank].mode="remote" 时使用，默认网关 api.openlux.ai/v1；
# 与 EMBEDDING_API_KEY 各自独立，即便指向同一网关也不要共用同一个值)
RERANK_API_KEY=
