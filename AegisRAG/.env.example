# ==============================================================================
# AegisRAG 环境变量模板 (.env)
# ==============================================================================

# Qdrant 远程鉴权密钥 (当 mode="server" 且启用鉴权时使用)
QDRANT_API_KEY=

# 远端 Embedding 服务密钥 (若未来从本地 FastEmbed 降级/升级为远端模型服务)
EMBEDDING_API_KEY=
