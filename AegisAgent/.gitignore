# Python Bytecode & Builds
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# Virtual Environment
.venv/
venv/
env/

# Type Checking & Linters
.mypy_cache/
.ruff_cache/

# Testing & Coverage
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage/
htmlcov/
coverage.xml
.benchmarks/
evaluation/**/benchmark_report.md.tmp

# Logging
*.log
logs/

# Secrets & Environment Variables (Keep .env.example)
.env
.env.*
!.env.example
*.pem
*.key

# IDEs & System Files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Agent Runtime Storage (保留目录骨架，忽略生成数据)
storage/checkpoints/*
!storage/checkpoints/.gitkeep
storage/traces/*
!storage/traces/.gitkeep
storage/artifacts/*
!storage/artifacts/.gitkeep
# 日志目录：上方 `logs/` 规则会连目录一起排除，必须先重新纳入目录再放行 .gitkeep
!storage/logs/
storage/logs/*
!storage/logs/.gitkeep
storage/*.db
storage/*.db-wal
storage/*.db-shm

# 接入层访问令牌（0600，绝不入版本库）
storage/api_token
storage/*.token

# SQLite & Databases
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# 误生成产物：SQLite 内存库 URI ":memory:" 被当成物理文件路径落盘
:memory:

# Cache & Models
.cache/
.fastembed/
.trafilatura/
